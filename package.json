{
  "name": "skyy-client",
  "version": "1.0.19",
  "description": "SKYY CLIENT - Modern Minecraft Java Edition launcher",
  "author": "SKYY CLIENT",
  "main": "dist-electron/electron/main/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "icons": "node scripts/build-icon.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "build": "npm run icons && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "protect": "node scripts/protect-build.js",
    "dist": "npm run build && npm run protect && electron-builder"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "better-sqlite3": "^11.3.0",
    "bytenode": "^1.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.7",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "javascript-obfuscator": "^5.6.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.5",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.skyy.client",
    "productName": "SKYY CLIENT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SkyyClient",
        "repo": "launcher-updates"
      }
    ],
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "resources/icon.ico",
        "to": "resources/icon.ico"
      },
      {
        "from": "public/icono.png",
        "to": "icono.png"
      },
      {
        "from": "resources/installer-header.bmp",
        "to": "resources/installer-header.bmp"
      },
      {
        "from": "resources/installer-sidebar.bmp",
        "to": "resources/installer-sidebar.bmp"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icono.png",
      "signingHashAlgorithms": [
        "sha256"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SKYY CLIENT",
      "installerIcon": "public/icono.png",
      "uninstallerIcon": "public/icono.png",
      "installerSidebar": "resources/installer-sidebar.bmp",
      "uninstallerSidebar": "resources/installer-sidebar.bmp",
      "installerHeader": "resources/installer-header.bmp",
      "include": "build/installer.nsh",
      "installerLanguages": [
        "Spanish"
      ],
      "language": "3082",
      "multiLanguageInstaller": false,
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.games"
    }
  }
}